  <div class="announcement">🌍 Think local. Reach global. Discover what your community can offer.</div>
  <header class="header">
    <div class="wrap nav">
      <a class="brand" href="#home" aria-label="Localio home"><span class="brand-mark">⌖</span><span>Localio<small>Local to Global</small></span></a>
      <nav class="nav-links" id="navLinks" aria-label="Main navigation">
        <a href="#home">Home</a><a href="#shop">Shop</a><a href="#about">About</a><a href="#services">Services</a><a href="#impact">Our Impact</a><a href="#support">Support</a><a href="#contact">Contact</a>
