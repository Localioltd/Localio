  <div class="overlay" id="overlay"></div>
  <aside class="cart-panel" id="cartPanel" aria-label="Shopping cart" aria-hidden="true"><div class="cart-head"><h3>Your cart <span id="cartTitleCount">(0)</span></h3><button class="icon-btn" id="cartClose" aria-label="Close cart">✕</button></div><div class="cart-items" id="cartItems"></div><div class="cart-foot"><div class="total-line"><span>Estimated total</span><span id="cartTotal">₹0</span></div><button class="btn" id="checkoutBtn" style="width:100%">Continue to order →</button><p class="muted" style="font-size:.76rem;margin-bottom:0">Order requests are not confirmed purchases. No payment is taken; Localio must confirm stock, shipping, and final price.</p></div></aside>
  <div class="modal" id="orderModal" role="dialog" aria-modal="true" aria-labelledby="orderTitle"><div class="modal-card"><div class="modal-top"><h3 id="orderTitle">Prepare your order</h3><button class="icon-btn" id="orderClose" aria-label="Close order form">✕</button></div><p class="muted">Add your details to prepare an order request. This demo does not charge payments or send orders to a server.</p><div id="orderSummary"></div><div class="modal-note">Before accepting live orders, connect a secure backend, inventory, shipping, and a payment provider.</div><form id="orderForm" class="form-grid"><div class="field"><label for="orderName">Full name *</label><input id="orderName" required></div><div class="field"><label for="orderEmail">Email *</label><input id="orderEmail" type="email" required></div><div class="field full"><label for="orderPhone">Phone / WhatsApp</label><input id="orderPhone" type="tel" placeholder="+91..."></div><div class="field full"><label for="orderAddress">Delivery address *</label><textarea id="orderAddress" required placeholder="Address, city, PIN/postal code"></textarea></div><div class="field full"><label for="orderNotes">Order notes (optional)</label><textarea id="orderNotes" placeholder="Delivery preferences or questions"></textarea></div><div class="field full"><button class="btn" type="submit">Prepare order email →</button></div></form></div></div>
  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    // Demo catalogue. Replace these sample items with your real products and prices.
    const products = [
      {id:1,name:"Farm-Fresh Spice Box",category:"Food",price:499,emoji:"🌶️",description:"A flavorful selection of everyday spices.",tag:"Local favorite"},
      {id:2,name:"Handcrafted Clay Mug",category:"Handmade",price:349,emoji:"🏺",description:"A unique handmade piece for your home.",tag:"Handmade"},
      {id:3,name:"Everyday Cotton Tote",category:"Fashion",price:299,emoji:"👜",description:"A reusable bag for daily adventures.",tag:"Eco choice"},
      {id:4,name:"Wireless Headphones",category:"Tech",price:1499,emoji:"🎧",description:"A simple tech essential for everyday use.",tag:"Popular"},
      {id:5,name:"Botanical Care Set",category:"Wellness",price:699,emoji:"🌿",description:"A plant-inspired personal care gift set.",tag:"Self care"},
      {id:6,name:"Artisan Gift Hamper",category:"Handmade",price:899,emoji:"🎁",description:"A thoughtful bundle from independent makers.",tag:"Gift idea"},
      {id:7,name:"Organic Tea Selection",category:"Food",price:399,emoji:"🍵",description:"A comforting collection for tea moments.",tag:"Community pick"},
      {id:8,name:"Everyday Notebook",category:"Handmade",price:249,emoji:"📒",description:"A journal for sketches, plans, and ideas.",tag:"Creator pick"}
    ];
    const state = {category:"All",query:"",cart:{}};
    const money = n => new Intl.NumberFormat("en-IN",{style:"currency",currency:"INR",maximumFractionDigits:0}).format(n);
    const $ = id => document.getElementById(id);
    function toast(message){const t=$("toast");t.textContent=message;t.classList.add("show");clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.classList.remove("show"),2600);}
    function renderProducts(){
      const list=products.filter(p=>(state.category==="All"||p.category===state.category)&&(p.name+" "+p.description+" "+p.category).toLowerCase().includes(state.query.toLowerCase()));
      $("productGrid").innerHTML=list.length?list.map(p=>`<article class="product-card"><div class="product-image" aria-hidden="true">${p.emoji}</div><div class="product-info"><span class="tag">${p.tag}</span><h3>${p.name}</h3><p>${p.description}</p><div class="product-bottom"><span class="price">${money(p.price)}</span><button class="add-btn" data-add="${p.id}">＋ Add to cart</button></div></div></article>`).join(""):`<div class="empty">No products found. Try another search or category.</div>`;
    }
    function cartQuantity(){return Object.values(state.cart).reduce((sum,item)=>sum+item.qty,0)}
    function cartTotal(){return Object.values(state.cart).reduce((sum,item)=>sum+item.price*item.qty,0)}
    function renderCart(){
      const items=Object.values(state.cart);
      $("cartCount").textContent=cartQuantity();$("cartTitleCount").textContent=`(${cartQuantity()})`;$("cartTotal").textContent=money(cartTotal());
      $("cartItems").innerHTML=items.length?items.map(item=>`<div class="cart-row"><div class="cart-emoji">${item.emoji}</div><div><strong>${item.name}</strong><small>${money(item.price)} each</small><div class="qty"><button data-qty="${item.id}" data-delta="-1" aria-label="Decrease ${item.name}">−</button><span>${item.qty}</span><button data-qty="${item.id}" data-delta="1" aria-label="Increase ${item.name}">＋</button></div></div><strong>${money(item.price*item.qty)}</strong></div>`).join(""):`<div class="empty">Your cart is empty.<br>Find something you love in the marketplace.</div>`;
      $("checkoutBtn").disabled=!items.length;$("checkoutBtn").style.opacity=items.length?"1":".5";
    }
    function addToCart(id){const p=products.find(x=>x.id===id);if(!p)return;if(state.cart[id])state.cart[id].qty++;else state.cart[id]={...p,qty:1};renderCart();toast(`${p.name} added to your cart.`)}
    function changeQty(id,delta){if(!state.cart[id])return;state.cart[id].qty+=delta;if(state.cart[id].qty<=0)delete state.cart[id];renderCart()}
    function openCart(){ $("cartPanel").classList.add("open");$("overlay").classList.add("show");$("cartPanel").setAttribute("aria-hidden","false");$("cartClose").focus() }
    function closeCart(){ $("cartPanel").classList.remove("open");$("overlay").classList.remove("show");$("cartPanel").setAttribute("aria-hidden","true") }
    function openOrder(){if(!cartQuantity()){toast("Add at least one item to your cart first.");return}closeCart();$("orderSummary").innerHTML=`<div style="background:#f3faf7;padding:12px;border-radius:12px;margin:12px 0"><strong>${cartQuantity()} item(s)</strong><span style="float:right;font-weight:850">${money(cartTotal())}</span><div class="muted" style="font-size:.82rem;margin-top:5px">${Object.values(state.cart).map(i=>`${i.name} × ${i.qty}`).join("<br>")}</div></div>`;$("orderModal").classList.add("show");$("orderName").focus()}
    function closeOrder(){$("orderModal").classList.remove("show")}
    $("productGrid").addEventListener("click",e=>{const b=e.target.closest("[data-add]");if(b)addToCart(Number(b.dataset.add))});
    $("cartItems").addEventListener("click",e=>{const b=e.target.closest("[data-qty]");if(b)changeQty(Number(b.dataset.qty),Number(b.dataset.delta))});
    $("filters").addEventListener("click",e=>{const b=e.target.closest("[data-category]");if(!b)return;state.category=b.dataset.category;document.querySelectorAll(".filter").forEach(x=>x.classList.toggle("active",x===b));renderProducts()});
    $("searchInput").addEventListener("input",e=>{state.query=e.target.value;renderProducts()});
    $("searchJump").addEventListener("click",()=>{$("shop").scrollIntoView({behavior:"smooth"});setTimeout(()=>$("searchInput").focus(),300)});
    $("cartOpen").addEventListener("click",openCart);$("cartClose").addEventListener("click",closeCart);$("overlay").addEventListener("click",closeCart);$("checkoutBtn").addEventListener("click",openOrder);$("orderClose").addEventListener("click",closeOrder);
    $("orderModal").addEventListener("click",e=>{if(e.target===$("orderModal"))closeOrder()});
    $("menuBtn").addEventListener("click",()=>{$("navLinks").classList.toggle("open")});
    $("navLinks").addEventListener("click",e=>{if(e.target.closest("a"))$("navLinks").classList.remove("open")});
    document.querySelectorAll("[data-service]").forEach(a=>a.addEventListener("click",()=>{const topic=$("contactTopic");const wanted=a.dataset.service;const option=[...topic.options].find(o=>o.text.toLowerCase().includes(wanted.toLowerCase())||wanted.toLowerCase().includes(o.text.toLowerCase()));if(option)topic.value=option.value}));
    $("contactForm").addEventListener("submit",e=>{e.preventDefault();const name=$("contactName").value.trim(),email=$("contactEmail").value.trim(),topic=$("contactTopic").value,message=$("contactMessage").value.trim();const subject=encodeURIComponent(`Localio enquiry: ${topic}`);const body=encodeURIComponent(`Name: ${name}\nEmail: ${email}\nTopic: ${topic}\n\n${message}`);toast("Opening your email app to prepare the message.");window.location.href=`mailto:localiopvt@proton.me?subject=${subject}&body=${body}`});
    $("orderForm").addEventListener("submit",e=>{e.preventDefault();const name=$("orderName").value.trim(),email=$("orderEmail").value.trim(),phone=$("orderPhone").value.trim(),address=$("orderAddress").value.trim(),notes=$("orderNotes").value.trim();const lines=Object.values(state.cart).map(i=>`${i.name} x ${i.qty} — ${money(i.price*i.qty)}`).join("\n");const subject=encodeURIComponent("Localio order request");const body=encodeURIComponent(`ORDER REQUEST — NOT YET CONFIRMED\n\nCustomer: ${name}\nEmail: ${email}\nPhone: ${phone}\nDelivery address: ${address}\n\nItems:\n${lines}\n\nEstimated subtotal: ${money(cartTotal())}\nNotes: ${notes}\n\nPlease confirm availability, shipping, and final price before payment.`);toast("Preparing your order email. No payment has been taken.");window.location.href=`mailto:localiopvt@proton.me?subject=${subject}&body=${body}`;closeOrder()});
    document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeCart();closeOrder();$("navLinks").classList.remove("open")}});
    $("year").textContent=new Date().getFullYear();renderProducts();renderCart();
  </script>

